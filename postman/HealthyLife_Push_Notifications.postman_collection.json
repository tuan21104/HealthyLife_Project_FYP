{
  "info": {
    "_postman_id": "b6a5b1c1-1f4f-4d0d-8e95-2b8d8b5d9d31",
    "name": "HealthyLife Push Notifications",
    "description": "Collection to test Firebase Cloud Messaging, token sync, and expense alert push notifications for HealthyLife backend.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Save FCM Token",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userId\": \"{{userId}}\",\n  \"fcmToken\": \"{{fcmToken}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/users/fcm-token",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "users",
            "fcm-token"
          ]
        },
        "description": "Store the device FCM token in the user's profile."
      },
      "response": []
    },
    {
      "name": "Test Push Notification",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fcmToken\": \"{{fcmToken}}\",\n  \"title\": \"Test Postman\",\n  \"body\": \"Backend HealthyLife đã thông với Firebase!\",\n  \"data\": {\n    \"type\": \"manual_test\",\n    \"screen\": \"home\",\n    \"source\": \"postman\"\n  }\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/test/push",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "test",
            "push"
          ]
        },
        "description": "Send a direct push notification to validate Firebase Admin + device token."
      },
      "response": []
    },
    {
      "name": "Trigger Expense Alert",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userId\": \"{{userId}}\",\n  \"amount\": 500000,\n  \"category\": \"Eating Out\",\n  \"note\": \"Postman overspending test\",\n  \"date\": \"{{todayIso}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/expense/add",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "expense",
            "add"
          ]
        },
        "description": "Create an expense record. If the daily total exceeds the safe threshold, backend sends a push notification."
      },
      "response": []
    },
    {
      "name": "Get User Profile",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/users/{{userId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "users",
            "{{userId}}"
          ]
        },
        "description": "Verify that the profile contains the stored fcmToken."
      },
      "response": []
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "userId",
      "value": ""
    },
    {
      "key": "fcmToken",
      "value": ""
    },
    {
      "key": "todayIso",
      "value": "2026-04-18T12:00:00.000Z"
    }
  ]
}