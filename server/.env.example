PORT=3000
MONGO_URI=mongodb://127.0.0.1:27017/healthylife
JWT_SECRET=SECRET_KEY_CUA_BAN
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# Mail provider: gmail | mailtrap | console
# console: khong gui email that, OTP se duoc in ra terminal server
MAIL_PROVIDER=gmail

# Common mail fields
MAIL_FROM=HealthyLife <no-reply@healthylife.app>
MAIL_USER=your-gmail-address@gmail.com
MAIL_PASS=your-gmail-app-password

# Mailtrap SMTP (used when MAIL_PROVIDER=mailtrap)
MAILTRAP_HOST=sandbox.smtp.mailtrap.io
MAILTRAP_PORT=2525
MAILTRAP_USER=your-mailtrap-username
MAILTRAP_PASS=your-mailtrap-password
